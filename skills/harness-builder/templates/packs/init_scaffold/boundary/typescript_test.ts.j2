import { readdirSync, readFileSync } from 'fs';
import { join, relative } from 'path';
import knownViolations from './known-violations.json';

const LAYER_RULES: Record<string, string[]> = {{ layer_rules_json }};
const SOURCE_ROOTS: string[] = {{ source_roots_json }};
const FROM_RE = /\bfrom\s+['"]([^'"]+)['"]/;

function collectFiles(dir: string, ext: string[]): string[] {
  const results: string[] = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) results.push(...collectFiles(fullPath, ext));
    else if (ext.some(e => entry.name.endsWith(e))) results.push(fullPath);
  }
  return results;
}

function getLayer(filePath: string): string | null {
  for (const root of SOURCE_ROOTS) {
    const rel = filePath.startsWith(root + '/') ? filePath.slice(root.length + 1) : null;
    if (!rel) continue;
    const first = rel.split('/')[0];
    if (first in LAYER_RULES) return first;
  }
  return null;
}

function resolveTargetLayer(importPath: string): string | null {
  const normalized = importPath.replace(/^[@~#]\//, '');
  const segments = normalized.split('/');
  return Object.keys(LAYER_RULES).find(layer => segments.includes(layer)) ?? null;
}

function scanFile(filePath: string) {
  const violations: Array<{ file: string; line: number; imports: string; from_layer: string; to_layer: string }> = [];
  const lines = readFileSync(filePath, 'utf-8').split('\n');
  const rel = relative(process.cwd(), filePath);
  const fromLayer = getLayer(rel);
  if (!fromLayer) return violations;
  for (let i = 0; i < lines.length; i++) {
    if (/^\s*import\s+type\s/.test(lines[i])) continue;
    const match = lines[i].match(FROM_RE);
    if (!match) continue;
    const targetLayer = resolveTargetLayer(match[1]);
    if (targetLayer && targetLayer !== fromLayer && !LAYER_RULES[fromLayer].includes(targetLayer)) {
      violations.push({ file: rel, line: i + 1, imports: match[1], from_layer: fromLayer, to_layer: targetLayer });
    }
  }
  return violations;
}

describe('Architecture Boundary Test', () => {
  const files = SOURCE_ROOTS.flatMap(root => collectFiles(root, ['.ts', '.tsx']));
  const allViolations = files.flatMap(scanFile);

  test('no new architecture violations', () => {
    const knownSet = new Set((knownViolations as any[]).map(v => `${v.file}:${v.imports}`));
    const newViolations = allViolations.filter(v => !knownSet.has(`${v.file}:${v.imports}`));
    if (newViolations.length > 0) {
      throw new Error('New architecture violations found:\n' + newViolations.map(v => `VIOLATION: ${v.file}:${v.line} imports ${v.imports} — ${v.from_layer} cannot import ${v.to_layer}. See docs/architecture/LAYERS.md`).join('\n'));
    }
  });

  test('violation count only shrinks', () => {
    expect(allViolations.length).toBeLessThanOrEqual((knownViolations as any[]).length);
  });
});
