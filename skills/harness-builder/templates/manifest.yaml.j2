version: 3
project_type: "{{ project_type }}"
project_phase: "{{ project_phase }}"
risk_level: "{{ risk_level }}"

harness_charter:
  objective: "{{ harness_objective }}"
  non_goals: []
  acceptance_criteria: []
  verification_path: "{{ verification_path }}"
  evidence_location: "{{ evidence_location }}"
  recovery_surface: "{{ recovery_surface }}"
  source_of_truth_priority: []

coverage_matrix:
  agent_entry: "{{ coverage_agent_entry }}"
  static_docs: "{{ coverage_static_docs }}"
  recovery_surface: "{{ coverage_recovery_surface }}"
  verification_entry: "{{ coverage_verification_entry }}"
  architecture_boundaries: "{{ coverage_architecture_boundaries }}"
  anti_entropy: "{{ coverage_anti_entropy }}"
  capability_fit: "{{ coverage_capability_fit }}"
  dynamic_context: "{{ coverage_dynamic_context }}"

harness_goals:
  controllable: true
  verifiable: true
  recoverable: true
  auditable: true
  sustainable: true

orchestration:
  mode: "{{ orchestration_mode }}"
  subagents: []
  write_policy: "main_agent_only"
  reason: "{{ orchestration_reason }}"

course_alignment:
  l01_failure_layers_considered: true
  l02_harness_subsystems_considered: true
  l03_repo_as_system_of_record_considered: true
  l04_instruction_splitting_considered: true
  l05_state_continuity_considered: true
  l06_initialization_considered: true
  l07_scope_control_considered: true
  l08_feature_list_considered: true
  l09_completion_gate_considered: true
  l10_e2e_smoke_considered: true
  l11_observability_considered: true
  l12_clean_state_considered: true

project_map:
  agent_entry: AGENTS.md
  context: docs/agent/project_context.md
  workflow: docs/agent/workflow.md
  verification_doc: docs/agent/verification.md
  verification_command: scripts/agent/check.sh
  state: .harness/state.md
  progress: .harness/progress.md
  handoff: .harness/session_handoff.md
  decisions: .harness/decisions.md
  skill_inventory: .harness/skill_inventory.json
  research_notes: .harness/research_notes.md

installed:
  instructions:
    - AGENTS.md
    - docs/agent/project_context.md
    - docs/agent/workflow.md
    - docs/agent/verification.md
  verification:
    - scripts/agent/check.sh
  state:
    - .harness/state.md
    - .harness/progress.md
    - .harness/session_handoff.md
  audit:
    - .harness/decisions.md
    - .harness/manifest.yaml

skills: []
hooks: []
subagents: []
mcp: []

deferred: []
rejected: []

validation:
  command: "bash scripts/agent/check.sh"
  expected_runtime: "fast"
