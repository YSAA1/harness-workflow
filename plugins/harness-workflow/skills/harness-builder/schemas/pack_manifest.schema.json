{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Builder Pack Manifest",
  "type": "object",
  "required": [
    "pack",
    "components"
  ],
  "properties": {
    "pack": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}