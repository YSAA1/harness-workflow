#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys

PROTECTED_RESEARCH_PREFIX = "{{ research_branch_prefix | default('research/') }}"
ALLOW_ENV = "{{ allow_research_push_env | default('ALLOW_RESEARCH_PUSH') }}"


def current_branch() -> str:
    try:
        return subprocess.check_output(
            ["git", "branch", "--show-current"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""


def main() -> int:
    branch = current_branch()
    if branch.startswith(PROTECTED_RESEARCH_PREFIX) and os.environ.get(ALLOW_ENV) != "1":
        print(
            f"Blocked push from {branch}. Research branches need graduation evidence first; "
            f"set {ALLOW_ENV}=1 only after approval.",
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
