#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import sys

BLOCK_PATTERNS = [r"\brm\s+-rf\b", r"\bgit\s+reset\s+--hard\b", r"\bgit\s+clean\s+-fdx\b"]

def main() -> int:
    raw = sys.stdin.read()
    try:
        event = json.loads(raw) if raw.strip() else {}
    except Exception:
        event = {}
    command = str(event.get('command') or event.get('cmd') or raw)
    for pattern in BLOCK_PATTERNS:
        if re.search(pattern, command):
            print(f"Blocked destructive command pending explicit approval: {command}", file=sys.stderr)
            return 2
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
