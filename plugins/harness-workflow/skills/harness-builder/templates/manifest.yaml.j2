version: 3
project_type: "{{ project_type }}"
project_phase: "{{ project_phase }}"
risk_level: "{{ risk_level }}"

harness_recommendation_contract:
  objective: "{{ harness_objective }}"
  non_goals: []
  acceptance_criteria: []
  verification_path: "{{ verification_path }}"
  evidence_location: "{{ evidence_location }}"
  recovery_surface: "{{ recovery_surface }}"
  source_of_truth_priority: []

recommendation_matrix:
  agent_entry: "{{ recommendation_agent_entry }}"
  static_docs: "{{ recommendation_static_docs }}"
  recovery_surface: "{{ recommendation_recovery_surface }}"
  verification_entry: "{{ recommendation_verification_entry }}"
  architecture_boundaries: "{{ recommendation_architecture_boundaries }}"
  anti_entropy: "{{ recommendation_anti_entropy }}"
  capability_fit: "{{ recommendation_capability_fit }}"
  dynamic_context: "{{ recommendation_dynamic_context }}"

harness_goals:
  controllable: true
  verifiable: true
  recoverable: true
  auditable: true
  sustainable: true

orchestration:
  mode: "{{ orchestration_mode }}"
  subagents: []
  write_policy: "main_agent_only"
  reason: "{{ orchestration_reason }}"

course_alignment:
  l01_failure_layers_considered: true
  l02_harness_subsystems_considered: true
  l03_repo_as_system_of_record_considered: true
  l04_instruction_splitting_considered: true
  l05_state_continuity_considered: true
  l06_initialization_considered: true
  l07_scope_control_considered: true
  l08_feature_list_considered: true
  l09_completion_gate_considered: true
  l10_e2e_smoke_considered: true
  l11_observability_considered: true
  l12_clean_state_considered: true

project_map:
  agent_entry: AGENTS.md
  context: "{{ project_context_path | default('docs/agent/project_context.md') }}"
  workflow: "{{ workflow_doc_path | default('docs/agent/workflow.md') }}"
  verification_doc: "{{ verification_doc_path | default('docs/agent/verification.md') }}"
  verification_command: "{{ fast_check_command | default('scripts/agent/check.sh') }}"
  recovery_surface: "{{ recovery_surface }}"
  decisions: "{{ decisions_path | default('.harness/decisions.md') }}"
  skill_inventory: "{{ skill_inventory_path | default('not_selected') }}"
  research_notes: "{{ research_notes_path | default('not_selected') }}"

asset_loading:
  default_assets:
    - AGENTS.md
    - "{{ recovery_surface }}"
    - "{{ decisions_path | default('.harness/decisions.md') }}"
  selected_assets: []
  conditional_assets: []
  recommendation_only_assets:
    - hooks
    - mcp
    - subagents
    - project-local skills
  explicit_only_assets:
    - Research Route

installed:
  instructions:
    - AGENTS.md
    - "{{ project_context_path | default('docs/agent/project_context.md') }}"
    - "{{ workflow_doc_path | default('docs/agent/workflow.md') }}"
    - "{{ verification_doc_path | default('docs/agent/verification.md') }}"
  verification:
    - "{{ fast_check_command | default('scripts/agent/check.sh') }}"
  state:
    - "{{ recovery_surface }}"
  audit:
    - "{{ decisions_path | default('.harness/decisions.md') }}"
    - .harness/manifest.yaml

skills: []
hooks: []
subagents: []
mcp: []

deferred: []
rejected: []

validation:
  command: "bash scripts/agent/check.sh"
  expected_runtime: "fast"
