{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Manifest",
  "type": "object",
  "required": [
    "version",
    "coverage_matrix"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "coverage_matrix": {
      "type": "object"
    },
    "packs": {
      "type": "object"
    },
    "installed": {
      "type": "object"
    }
  }
}