name: CI
on:
  push:
    branches: [{{ default_branch | default("main") }}]
  pull_request:
    branches: [{{ default_branch | default("main") }}]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
{% for job in jobs %}
  {{ job.name }}:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ checkout_sha }} # {{ checkout_version }}
      {% if job.setup_action %}- uses: {{ job.setup_action }}
      {% endif %}- run: {{ install_command }}
      - run: {{ job.command }}
{% endfor %}
